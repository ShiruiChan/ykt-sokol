{
	"name": "ykt-sokol",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "node scripts/pull-content.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
		"build:spa": "vite build",
		"preview": "npx serve@14 dist",
		"typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.api.json",
		"test": "node --test src/utils/*.test.mjs scripts/*.test.mjs",
		"optimize:images": "node scripts/optimize-images.mjs",
		"images:variants": "node scripts/build-image-variants.mjs",
		"content:pull": "node scripts/pull-content.mjs",
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:seed": "node scripts/db-seed.mjs",
		"admin:check": "node scripts/admin-dev.mjs --check"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"@neondatabase/serverless": "^1.2.0",
		"@tailwindcss/vite": "^4.1.8",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.8.2",
		"framer-motion": "^12.18.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-photo-view": "^1.2.7",
		"react-swipeable": "^7.0.2",
		"tailwindcss": "^4.1.8",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"globals": "^16.0.0",
		"react-router-dom": "^7.6.1",
		"sharp": "^0.33.5",
		"typescript": "^5.9.3",
		"vite": "^6.3.5"
	}
}
