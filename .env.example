# Переменные окружения. На сервере — файл /etc/ykt-sokol.env (см. deploy/README.md),
# локально — скопируйте этот файл в .env.local. Реальные значения сюда не пишем.

# --- Заявки с сайта ---
# Основной канал: бот, в который приходят заявки, и чат/группа для них
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Резервный канал — письмо, если Telegram не настроен или не ответил.
# Яндекс 360: smtps://login%40domain.ru:пароль-приложения@smtp.yandex.ru:465
# (@ в логине пишется как %40)
SMTP_URL=
# Куда слать заявки, можно несколько через запятую
MAIL_TO=
# От кого (по умолчанию — логин из SMTP_URL)
# MAIL_FROM=

# --- База данных и файлы ---
# PostgreSQL на сервере. Без неё сайт собирается на снимке content/*.json
DATABASE_URL=
# Папка для фото и PDF из админки — вне папки сборки. Локально не нужна
# (берётся .admin-dev/uploads)
UPLOADS_DIR=

# --- Админ-панель (/admin) ---
# Пароль владельца. Длинный, нигде больше не используется
ADMIN_PASSWORD=
# Ключ подписи cookie сессии, случайная строка не короче 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Команда кнопки «Опубликовать» — на сервере /srv/ykt-sokol/app/deploy/rebuild.sh
PUBLISH_COMMAND=
# Только для локальной разработки без БД: file — админка пишет прямо в content/*.json.
# На сервере (NODE_ENV=production) игнорируется. В `npm run dev` включается сам,
# если DATABASE_URL пуст.
# ADMIN_CONTENT_STORE=file

# --- Клиентские (попадают в бандл, секретов здесь нет) ---
# Номер счётчика Яндекс.Метрики
VITE_YM_ID=
# Боевой адрес сайта без слэша на конце: canonical, sitemap, robots.txt
VITE_SITE_URL=
