# Серверные переменные (задаются в Vercel → Settings → Environment Variables).
# Реальные значения сюда не пишем: для локальной работы скопируйте файл в .env.local.

# Бот, в который приходят заявки с сайта
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда бот пишет заявки
TELEGRAM_CHAT_ID=

# --- Админ-панель (/admin) ---
# Строка подключения к Postgres (Neon). Появляется сама после подключения
# Neon через Vercel Marketplace. Без неё сайт собирается на снимке content/*.json.
DATABASE_URL=
# Токен Vercel Blob для загрузки фото и PDF. Появляется сам после подключения Blob.
BLOB_READ_WRITE_TOKEN=
# Пароль владельца для входа в админку. Длинный, нигде больше не используется.
ADMIN_PASSWORD=
# Ключ подписи cookie сессии, случайная строка не короче 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Deploy Hook проекта (Vercel → Settings → Git → Deploy Hooks) — кнопка «Опубликовать»
VERCEL_DEPLOY_HOOK_URL=
# Только для локальной разработки без БД: file — админка пишет прямо в content/*.json.
# На Vercel игнорируется. В `npm run dev` включается сам, если DATABASE_URL пуст.
# ADMIN_CONTENT_STORE=file

# Клиентские переменные (попадают в бандл, секретов здесь нет)
# Номер счётчика Яндекс.Метрики
VITE_YM_ID=
